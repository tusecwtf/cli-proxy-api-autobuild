@@ -110,6 +111,30 @@ type DevinUsage struct {
 	Headers          map[string]string `json:"headers,omitempty"`
 }
 
+// DevinTokenBreakdown maps Devin wire counters onto independent canonical buckets.
+// Tag 2 is uncached input, tag 5 is cache read, tag 4 is cache write, and tag 3 is
+// ordinary output. This protocol reports no separate reasoning count.
+// A nil usage, a negative counter, int64 overflow, or any result that is not a
+// valid complete breakdown returns false. The breakdown from the shared constructor
+// is returned unchanged so a caller can publish the inconsistent accounting.
+func DevinTokenBreakdown(u *DevinUsage) (usage.TokenBreakdown, bool) {
+	if u == nil {
+		return usage.TokenBreakdown{}, false
+	}
+	breakdown := usage.NewIndependentTokenBreakdown(
+		u.PromptTokens,
+		u.CachedTokens,
+		u.CacheWriteTokens,
+		u.CompletionTokens,
+		0,
+		0,
+	)
+	if breakdown.Quality != usage.TokenAccountingQualityComplete || !breakdown.Valid() {
+		return breakdown, false
+	}
+	return breakdown, true
+}
+
 // DevinFrameResult represents decoded content from a single Connect-proto frame.
 type DevinFrameResult struct {
 	OutputID                string
