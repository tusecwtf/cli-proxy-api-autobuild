+func TestDevinTokenBreakdown(t *testing.T) {
+	breakdown, ok := DevinTokenBreakdown(nil)
+	if ok || breakdown.Quality == usage.TokenAccountingQualityComplete || breakdown.Valid() {
+		t.Fatalf("nil usage ok=%v breakdown=%+v", ok, breakdown)
+	}
+
+	cases := []struct {
+		name     string
+		usage    DevinUsage
+		input    int64
+		output   int64
+		total    int64
+		uncached int64
+		read     int64
+		write    int64
+	}{
+		{name: "no cache write", usage: DevinUsage{PromptTokens: 8, CompletionTokens: 4}, input: 8, output: 4, total: 12, uncached: 8},
+		{name: "cache write below uncached input", usage: DevinUsage{PromptTokens: 10, CachedTokens: 50, CacheWriteTokens: 3, CompletionTokens: 2}, input: 63, output: 2, total: 65, uncached: 10, read: 50, write: 3},
+		{name: "cache write above uncached input", usage: DevinUsage{PromptTokens: 3, CachedTokens: 50, CacheWriteTokens: 14361, CompletionTokens: 10}, input: 14414, output: 10, total: 14424, uncached: 3, read: 50, write: 14361},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, gotOK := DevinTokenBreakdown(&tc.usage)
+			if !gotOK || !got.Valid() || got.Quality != usage.TokenAccountingQualityComplete ||
+				got.Input.TotalTokens != tc.input || got.Input.UncachedTokens != tc.uncached ||
+				got.Input.CacheReadTokens != tc.read || got.Input.CacheWriteTokens != tc.write ||
+				got.Output.TotalTokens != tc.output || got.Output.NonReasoningTokens != tc.output ||
+				got.Output.ReasoningTokens != 0 || got.UnclassifiedTokens != 0 || got.TotalTokens != tc.total {
+				t.Fatalf("ok=%v breakdown=%+v", gotOK, got)
+			}
+		})
+	}
+
+	rejected := []DevinUsage{
+		{PromptTokens: -1, CompletionTokens: 4},
+		{PromptTokens: math.MaxInt64, CacheWriteTokens: 1, CompletionTokens: 10},
+	}
+	for _, usageValue := range rejected {
+		got, gotOK := DevinTokenBreakdown(&usageValue)
+		if gotOK || got.Quality != usage.TokenAccountingQualityInconsistent || !got.Valid() {
+			t.Fatalf("ok=%v breakdown=%+v", gotOK, got)
+		}
+	}
+}
