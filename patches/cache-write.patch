+// devinTokenAccountingError is the safe 502 for Devin counters that cannot form a
+// valid complete breakdown. breakdown is the helper's inconsistent result.
+type devinTokenAccountingError struct {
+	statusErr
+	breakdown usage.TokenBreakdown
+}
+
+func newDevinTokenAccountingError(breakdown usage.TokenBreakdown) devinTokenAccountingError {
+	return devinTokenAccountingError{
+		statusErr: statusErr{code: http.StatusBadGateway, msg: "invalid Devin token accounting"},
+		breakdown: breakdown,
+	}
+}
+
+func writeDevinCanonicalUsage(doc *ojson.Doc, prefix string, breakdown usage.TokenBreakdown, wire *helps.DevinUsage) {
+	_ = doc.Set(prefix+"total_input_tokens", breakdown.Input.TotalTokens)
+	_ = doc.Set(prefix+"total_output_tokens", breakdown.Output.TotalTokens)
+	_ = doc.Set(prefix+"total_cached_tokens", wire.CachedTokens)
+	if wire.CacheWriteTokens > 0 {
+		_ = doc.Set(prefix+"cache_write_tokens", wire.CacheWriteTokens)
+	}
+	_ = doc.Set(prefix+"total_tokens", breakdown.TotalTokens)
+}
